# Collects every devices/*/device.cmake and generates the model registry.
#
# A device.cmake calls:
#   metalclaw_device(<id> SYMBOL <c symbol of its struct metalclaw_model>
#                    ABI <version it was written against>
#                    SOURCES <files...> [INCLUDE <dirs...>])
# Nothing else in the tree needs editing to add a device. A device whose ABI
# does not match core/include/metalclaw/version.h fails the configure step.

file(STRINGS "${METALCLAW_ROOT}/core/include/metalclaw/version.h" _abi_line REGEX "define METALCLAW_ABI_VERSION")
string(REGEX REPLACE ".*METALCLAW_ABI_VERSION[ \t]+([0-9]+).*" "\\1" METALCLAW_ABI_VERSION "${_abi_line}")

set(METALCLAW_DEVICE_SYMBOLS "")
add_library(metalclaw_devices INTERFACE)

function(metalclaw_device id)
    cmake_parse_arguments(DEV "" "SYMBOL;ABI" "SOURCES;INCLUDE" ${ARGN})
    if(NOT DEV_SYMBOL OR NOT DEV_SOURCES OR NOT DEV_ABI)
        message(FATAL_ERROR "metalclaw_device(${id}): SYMBOL, ABI and SOURCES are required")
    endif()
    if(NOT DEV_ABI STREQUAL METALCLAW_ABI_VERSION)
        message(FATAL_ERROR "device ${id} targets ABI ${DEV_ABI}; this tree is ABI ${METALCLAW_ABI_VERSION}")
    endif()
    list(APPEND METALCLAW_DEVICE_SYMBOLS ${DEV_SYMBOL})
    set(METALCLAW_DEVICE_SYMBOLS ${METALCLAW_DEVICE_SYMBOLS} PARENT_SCOPE)
    list(APPEND METALCLAW_DEVICE_SOURCES ${DEV_SOURCES})
    set(METALCLAW_DEVICE_SOURCES ${METALCLAW_DEVICE_SOURCES} PARENT_SCOPE)
    target_include_directories(metalclaw_devices INTERFACE ${DEV_INCLUDE})
endfunction()

file(GLOB _device_cmakes LIST_DIRECTORIES false "${METALCLAW_ROOT}/devices/*/device.cmake")
list(SORT _device_cmakes)
foreach(_cmake ${_device_cmakes})
    include(${_cmake})
endforeach()

set(_registry "${CMAKE_BINARY_DIR}/metalclaw_registry.c")
set(_body "// Generated by core/cmake/devices.cmake. Do not edit.\n#include \"metalclaw/runtime.h\"\n\n")
foreach(_sym ${METALCLAW_DEVICE_SYMBOLS})
    string(APPEND _body "extern const struct metalclaw_model ${_sym};\n")
endforeach()
string(APPEND _body "\nconst struct metalclaw_model *const metalclaw_models[] = {\n")
foreach(_sym ${METALCLAW_DEVICE_SYMBOLS})
    string(APPEND _body "    &${_sym},\n")
endforeach()
list(LENGTH METALCLAW_DEVICE_SYMBOLS _count)
string(APPEND _body "    NULL,\n};\nconst size_t metalclaw_model_count = ${_count};\n")
file(WRITE "${_registry}.new" "${_body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_registry}.new" "${_registry}")

set(METALCLAW_REGISTRY_SOURCE "${_registry}")
