index 1c6de5f..a7b728e 100644
--- a/probe-rs/src/architecture/arm/core/armv8m.rs
+++ b/probe-rs/src/architecture/arm/core/armv8m.rs
@@ -88,6 +88,7 @@ impl<'probe> Armv8m<'probe> {
         timeout: Duration,
         predicate: impl Fn(CoreStatus) -> bool,
     ) -> Result<(), Error> {
+        let timeout = super::cortex_m_debug_timeout(timeout);
         let start = Instant::now();
 
         while !predicate(self.status()?) {
diff --git a/probe-rs/src/architecture/arm/core/mod.rs b/probe-rs/src/architecture/arm/core/mod.rs
index a2c45f9..4b27812 100644
--- a/probe-rs/src/architecture/arm/core/mod.rs
+++ b/probe-rs/src/architecture/arm/core/mod.rs
@@ -23,6 +23,69 @@ pub(crate) mod cortex_m;
 pub(crate) mod instructions;
 pub mod registers;
 
+// Cortex-M debugging over a slow transport can exceed hardware-oriented host
+// deadlines while the target still completes normal halt/step operations. This
+// changes only host polling deadlines when explicitly configured.
+static ARM_DEBUG_TIMEOUT_MULTIPLIER: std::sync::LazyLock<u32> = std::sync::LazyLock::new(|| {
+    parse_arm_debug_timeout_multiplier(
+        std::env::var("ARM_DEBUG_TIMEOUT_MULTIPLIER")
+            .ok()
+            .as_deref(),
+    )
+});
+
+fn parse_arm_debug_timeout_multiplier(configured: Option<&str>) -> u32 {
+    let multiplier = configured
+        .and_then(|value| value.parse::<u32>().ok())
+        .filter(|value| *value > 0);
+    if configured.is_some() && multiplier.is_none() {
+        tracing::warn!("ARM_DEBUG_TIMEOUT_MULTIPLIER must be in 1..=4294967295; using 1");
+    }
+    multiplier.unwrap_or(1)
+}
+
+fn cortex_m_debug_timeout(timeout: std::time::Duration) -> std::time::Duration {
+    timeout.saturating_mul(*ARM_DEBUG_TIMEOUT_MULTIPLIER)
+}
+
+#[cfg(test)]
+mod debug_timeout_tests {
+    use super::{cortex_m_debug_timeout, parse_arm_debug_timeout_multiplier};
+    use std::time::Duration;
+
+    #[test]
+    fn preserves_default_and_rejects_invalid_host_configuration() {
+        for value in [
+            None,
+            Some(""),
+            Some("0"),
+            Some("-1"),
+            Some("abc"),
+            Some("4294967296"),
+        ] {
+            assert_eq!(parse_arm_debug_timeout_multiplier(value), 1, "{value:?}");
+        }
+    }
+
+    #[test]
+    fn scales_the_requested_deadline_without_overflowing() {
+        assert_eq!(parse_arm_debug_timeout_multiplier(Some("30")), 30);
+        let expected_ms = std::env::var("EXPECTED_ARM_DEBUG_TIMEOUT_MILLIS")
+            .map(|value| value.parse::<u64>().expect("invalid test expectation"))
+            .unwrap_or(100);
+        assert_eq!(
+            cortex_m_debug_timeout(Duration::from_millis(100)),
+            Duration::from_millis(expected_ms)
+        );
+        assert_eq!(
+            parse_arm_debug_timeout_multiplier(Some("4294967295")),
+            u32::MAX
+        );
+        assert_eq!(cortex_m_debug_timeout(Duration::MAX), Duration::MAX);
+        assert_eq!(cortex_m_debug_timeout(Duration::ZERO), Duration::ZERO);
+    }
+}
+
