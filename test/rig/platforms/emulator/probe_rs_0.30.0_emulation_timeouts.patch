From db434a31c0a362a30888f6999f47ba5ce2da882c Mon Sep 17 00:00:00 2001
From: renzbagaporo <renz.bagaporo@gmail.com>
Date: Fri, 30 Oct 2026 08:26:17 +0900
Subject: [PATCH 2/3] flashing: Allow configuring the host routine watchdog

---
 probe-rs/src/flashing/flasher.rs | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/probe-rs/src/flashing/flasher.rs b/probe-rs/src/flashing/flasher.rs
index 96acd68..c7087b3 100644
--- a/probe-rs/src/flashing/flasher.rs
+++ b/probe-rs/src/flashing/flasher.rs
@@ -13,6 +13,7 @@ use crate::{Core, InstructionSet, core::CoreRegisters, session::Session};
 use crate::{CoreStatus, Target};
 use std::borrow::Cow;
 use std::marker::PhantomData;
+use std::sync::LazyLock;
 use std::{
     fmt::Debug,
     time::{Duration, Instant},
@@ -21,6 +22,20 @@ use std::{
 /// The timeout for init/uninit routines.
 const INIT_TIMEOUT: Duration = Duration::from_secs(2);
 
+// Emulated targets can take longer in host time while retaining their normal
+// target timing. This scales only the host watchdog for flash routine calls.
+static FLASH_TIMEOUT_MULTIPLIER: LazyLock<u32> = LazyLock::new(|| {
+    let configured = std::env::var("FLASH_ALGORITHM_TIMEOUT_MULTIPLIER").ok();
+    let multiplier = configured
+        .as_deref()
+        .and_then(|value| value.parse::<u32>().ok())
+        .filter(|value| *value > 0);
+    if configured.is_some() && multiplier.is_none() {
+        tracing::warn!("FLASH_ALGORITHM_TIMEOUT_MULTIPLIER must be in 1..=4294967295; using 1");
+    }
+    multiplier.unwrap_or(1)
+});
+
 pub(super) trait Operation {
     const OPERATION: u32;
     const NAME: &'static str;
@@ -974,6 +989,22 @@ impl<O: Operation> ActiveFlasher<'_, '_, O> {
 
     #[tracing::instrument(skip(self))]
     pub(super) fn wait_for_completion(&mut self, timeout: Duration) -> Result<u32, FlashError> {
+        let original_timeout = timeout;
+        let multiplier = *FLASH_TIMEOUT_MULTIPLIER;
+        let timeout = timeout.checked_mul(multiplier).unwrap_or_else(|| {
+            tracing::warn!(
+                ?original_timeout,
+                multiplier,
+                "Flash watchdog overflow; using original timeout"
+            );
+            original_timeout
+        });
+        tracing::debug!(
+            ?original_timeout,
+            ?timeout,
+            multiplier,
+            "Flash routine host watchdog"
+        );
         tracing::debug!("Waiting for routine call completion.");
         let regs = self.core.registers();
 
