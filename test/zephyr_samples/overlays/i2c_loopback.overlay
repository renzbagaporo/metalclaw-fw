/*
 * samples/drivers/i2c/rtio_loopback: I2C1 (GP6 SDA, GP7 SCL) as the
 * controller and I2C0 (GP4 SDA, GP5 SCL, i2c0.overlay) as the target, at
 * the standard rate. The harness joins SDA to SDA and SCL to SCL with
 * open-drain jumpers, as the sample's i2c_bus_short fixture does. Both
 * buses take the pads' pull-ups, as pico-examples' slave_mem_i2c does on
 * the same pins (gpio_pull_up); without them the controller's first
 * transfer fails on the carrier. Both take a 7-cycle (56 ns at 125 MHz)
 * spike filter, past UM10204's 50 ns tSP, and a 38-cycle (300 ns) SDA hold,
 * as pico-sdk configures them (hardware_i2c/i2c.c); the rpi_pico board
 * leaves the DesignWare defaults, one cycle each.
 */
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	aliases {
		i2c-controller = &i2c1;
		i2c-controller-target = &i2c0;
	};
};

&pinctrl {
	i2c1_gp6_gp7: i2c1_gp6_gp7 {
		group1 {
			pinmux = <I2C1_SDA_P6>, <I2C1_SCL_P7>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up;
		};
	};
};

&i2c0_gp4_gp5 {
	group1 {
		bias-pull-up;
	};
};

&i2c0 {
	fs-spike-len = <7>;
	sda-hold-tx = <38>;
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	fs-spike-len = <7>;
	sda-hold-tx = <38>;
	pinctrl-0 = <&i2c1_gp6_gp7>;
	pinctrl-names = "default";
};
