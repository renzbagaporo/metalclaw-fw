# SPDX-License-Identifier: Apache-2.0 OR MIT
# Writes OUT, a header defining MCLW_BUILD_VERSION, from the version in
# ROOT/core/include/metalclaw/version.h and the git checkout at ROOT:
#   the release's tagged commit      0.1.0
#   a later commit                   0.1.0-3-gabc1234def0
#   a commit with no matching tag    0.1.0-gabc1234def0
#   uncommitted changes              any of those, then -dirty
#   no git checkout                  0.1.0
# The file is only rewritten when the string changes, so a build that changes
# nothing recompiles nothing.
#   cmake -DROOT=<repo> -DOUT=<header> -P build_version.cmake

file(READ "${ROOT}/core/include/metalclaw/version.h" header)
foreach(part MAJOR MINOR PATCH)
    if(NOT header MATCHES "#define MCLW_VERSION_${part} ([0-9]+)")
        message(FATAL_ERROR "version.h has no MCLW_VERSION_${part}")
    endif()
    set(${part} "${CMAKE_MATCH_1}")
endforeach()
set(base "${MAJOR}.${MINOR}.${PATCH}")
set(version "${base}")

find_package(Git QUIET)
if(GIT_FOUND)
    # A tree outside git that sits inside another checkout is not that
    # checkout's commit.
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" rev-parse --show-toplevel
                    OUTPUT_VARIABLE top OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE no_git)
    if(NOT no_git)
        get_filename_component(top "${top}" REALPATH)
        get_filename_component(root "${ROOT}" REALPATH)
        if(NOT top STREQUAL root)
            set(no_git 1)
        endif()
    endif()
    if(NOT no_git)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" rev-parse --short=12 HEAD
                        OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE no_git)
    endif()
    if(NOT no_git)
        # Only a tag of this version counts: after a bump, the last release's
        # tag would name the wrong version.
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" describe --tags --abbrev=12 --match "v${base}"
                        OUTPUT_VARIABLE described OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
                        RESULT_VARIABLE no_tag)
        if(NOT no_tag AND described MATCHES "^v(.+)$")
            set(version "${CMAKE_MATCH_1}")
        else()
            set(version "${base}-g${sha}")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" status --porcelain --untracked-files=no
                        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(changes)
            string(APPEND version "-dirty")
        endif()
    endif()
endif()

set(text "// Generated by core/cmake/build_version.cmake.\n#define MCLW_BUILD_VERSION \"${version}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT text STREQUAL old)
    file(WRITE "${OUT}" "${text}")
endif()
