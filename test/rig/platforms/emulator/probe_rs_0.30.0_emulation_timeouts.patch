From c94ac3b2b8902fd3d6fcc3ba5c53d33ec1a93e7f Mon Sep 17 00:00:00 2001
From: renzbagaporo <renz.bagaporo@gmail.com>
Date: Fri, 30 Oct 2026 06:59:54 +0900
Subject: [PATCH 1/3] cmsisdap: Allow configuring the host USB transport
 timeout

---
 probe-rs/src/probe/cmsisdap/commands/mod.rs | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/probe-rs/src/probe/cmsisdap/commands/mod.rs b/probe-rs/src/probe/cmsisdap/commands/mod.rs
index b949587..65327a7 100644
--- a/probe-rs/src/probe/cmsisdap/commands/mod.rs
+++ b/probe-rs/src/probe/cmsisdap/commands/mod.rs
@@ -10,13 +10,28 @@ use crate::probe::usb_util::InterfaceExt;
 use crate::probe::{ProbeError, WireProtocol};
 use std::io::ErrorKind;
 use std::str::Utf8Error;
+use std::sync::LazyLock;
 use std::time::Duration;
 
 use self::general::host_status::HostStatusRequest;
 use self::swj::clock::SWJClockRequest;
 use self::transfer::InnerTransferBlockRequest;
 
-const USB_TIMEOUT: Duration = Duration::from_millis(1000);
+// Slow USB transports can configure their host deadline without changing the
+// target's protocol timing. Keep the HID millisecond argument within i32.
+static USB_TIMEOUT: LazyLock<Duration> = LazyLock::new(|| {
+    let configured = std::env::var("CMSIS_DAP_USB_TIMEOUT_MS").ok();
+    let milliseconds = configured
+        .as_deref()
+        .and_then(|value| value.parse::<u32>().ok())
+        .filter(|value| *value > 0 && *value <= i32::MAX as u32);
+    if configured.is_some() && milliseconds.is_none() {
+        tracing::warn!("CMSIS_DAP_USB_TIMEOUT_MS must be in 1..=2147483647; using 1000 ms");
+    }
+    let milliseconds = milliseconds.unwrap_or(1000);
+    tracing::debug!(milliseconds, "CMSIS-DAP host USB timeout");
+    Duration::from_millis(u64::from(milliseconds))
+});
 
 #[derive(Debug, thiserror::Error, docsplay::Display)]
 pub enum CmsisDapError {
@@ -204,7 +219,7 @@ impl CmsisDapDevice {
                 }
             }
             CmsisDapDevice::V2 { handle, in_ep, .. } => {
-                Ok(handle.read_bulk(*in_ep, buf, USB_TIMEOUT)?)
+                Ok(handle.read_bulk(*in_ep, buf, *USB_TIMEOUT)?)
             }
         }
     }
@@ -216,7 +231,7 @@ impl CmsisDapDevice {
             CmsisDapDevice::V1 { handle, .. } => Ok(handle.write(buf)?),
             CmsisDapDevice::V2 { handle, out_ep, .. } => {
                 // Skip first byte as it's set to 0 for HID transfers
-                Ok(handle.write_bulk(*out_ep, &buf[1..], USB_TIMEOUT)?)
+                Ok(handle.write_bulk(*out_ep, &buf[1..], *USB_TIMEOUT)?)
             }
         }
     }
