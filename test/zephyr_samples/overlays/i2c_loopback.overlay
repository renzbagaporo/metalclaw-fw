/*
 * samples/drivers/i2c/rtio_loopback: I2C1 (GP6 SDA, GP7 SCL) as the
 * controller and I2C0 (GP4 SDA, GP5 SCL, i2c0.overlay) as the target, at
 * the standard rate. The harness joins SDA to SDA and SCL to SCL with
 * open-drain jumpers, as the sample's i2c_bus_short fixture does.
 */
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	aliases {
		i2c-controller = &i2c1;
		i2c-controller-target = &i2c0;
	};
};

&pinctrl {
	i2c1_gp6_gp7: i2c1_gp6_gp7 {
		group1 {
			pinmux = <I2C1_SDA_P6>, <I2C1_SCL_P7>;
			input-enable;
			input-schmitt-enable;
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c1_gp6_gp7>;
	pinctrl-names = "default";
};
